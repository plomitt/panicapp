{
  "expo": {
    "name": "panicapp",
    "slug": "panicapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ground-icon-tinted-rounded.png",
    "scheme": "panicapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/images/ground-icon-tinted-rounded.png",
        "dark": "./assets/images/ground-icon-tinted-rounded.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#151718",
        "foregroundImage": "./assets/images/ground-icon-tinted-rounded.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ground-favicon-tinted-rounded.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}